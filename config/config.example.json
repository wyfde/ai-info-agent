{
  "timezone": "Asia/Shanghai",
  "window_hours": 24,
  "inbox_dir": "data/inbox",
  "raw_dir": "data/raw",
  "output_dir": "outputs",
  "llm": {
    "api_style": "chat_completions",
    "base_url": "https://api.deepseek.com/v1",
    "model": "deepseek-chat",
    "api_key": "",
    "api_key_env": "AI_JOB_INTEL_LLM_API_KEY",
    "max_tokens": 4096,
    "timeout_seconds": 120
  },
  "wechat": {
    "rss_feeds": []
  },
  "feishu": {
    "delivery": "bitable",
    "app_id_env": "FEISHU_APP_ID",
    "app_id": "",
    "app_secret_env": "FEISHU_APP_SECRET",
    "app_secret": "",
    "group_chats": [],
    "webhook_url_env": "FEISHU_WEBHOOK_URL",
    "webhook_url": "",
    "receive_id_env": "FEISHU_RECEIVE_ID",
    "receive_id": "",
    "receive_id_type": "chat_id",
    "bitable": {
      "url": "",
      "app_token": "",
      "table_id": "",
      "date_field_type": "text",
      "link_field_type": "url",
      "fields": {
        "date": "日期",
        "category": "分类",
        "title": "标题",
        "link": "链接",
        "summary": "摘要",
        "implication": "求职启示"
      }
    }
  }
}
